# =============================================
# Application settings
# =============================================
APP_ENV=production
APP_URL=http://localhost:8000
APP_QUEUES_COUNTER=2
APP_KEY=
# Generate with: echo "base64:$(openssl rand -base64 32)"

# =============================================
# Database settings
# =============================================
DB_CONNECTION=sqlite
DB_DATABASE=/app/storage/database.sqlite

# =============================================
# Redis settings
# - Used only by the browser stream relay.
# =============================================
REDIS_HOST=redis
REDIS_PORT=6379

# =============================================
# Pinokio settings
# - Used to call Chromium in headless mode.
# =============================================
PINOKIO_HOST=pinokio
PINOKIO_PORT=3000
PINOKIO_TOKEN=

# =============================================
# Runner settings
# - Used by flow runners.
# =============================================
RUNNER_API_INTERNAL_URL=http://localhost:8000/api/internal/runner

# =============================================
# Browser stream settings
# - Used to stream the browser to the client.
# =============================================
BROWSER_STREAM_INTERNAL_URL=http://localhost:6080
BROWSER_STREAM_PUBLIC_URL=http://localhost:6080
BROWSER_STREAM_ALLOWED_ORIGINS=*
# Generate with: openssl rand -hex 32
BROWSER_STREAM_SECRET=